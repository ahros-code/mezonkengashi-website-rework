# Production origin, used for canonical URLs, hreflang, sitemap and OG tags.
NEXT_PUBLIC_SITE_URL=https://mezonkengashi.uz

# ---------------------------------------------------------------------------
# Search engines
# ---------------------------------------------------------------------------

# Ownership meta tags. Paste only the content value each console gives you.
# Google Search Console -> Settings -> Ownership verification -> HTML tag
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Yandex Webmaster -> Rights verification -> Meta tag
NEXT_PUBLIC_YANDEX_VERIFICATION=
# Bing Webmaster Tools -> Add site -> HTML Meta Tag (msvalidate.01)
NEXT_PUBLIC_BING_VERIFICATION=

# IndexNow key (8-128 hex chars: `openssl rand -hex 16`). Served at
# /indexnow-key.txt; every Sanity publish then pings Bing, Yandex, Seznam and
# Naver with the changed URLs in all three editions.
INDEXNOW_KEY=

# ---------------------------------------------------------------------------
# Sanity CMS (Bilim markazi content)
#
# With NEXT_PUBLIC_SANITY_PROJECT_ID unset the site serves the content bundled
# in src/content, so local work and CI need none of this.
# ---------------------------------------------------------------------------

# sanity.io/manage -> your project -> the id under the project name.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Only for a private dataset. A public dataset needs no token and is served
# from Sanity's CDN, which is faster.
SANITY_API_READ_TOKEN=

# Write token, used only by `npm run sanity:seed`. Never ship this to the client.
SANITY_WRITE_TOKEN=

# Shared secret for the Sanity publish webhook -> /api/revalidate.
SANITY_REVALIDATE_SECRET=
