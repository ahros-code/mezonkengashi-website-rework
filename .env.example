# Production origin, used for canonical URLs, hreflang, sitemap and OG tags.
NEXT_PUBLIC_SITE_URL=https://mezon.uz

# ---------------------------------------------------------------------------
# Sanity CMS (Bilim markazi content)
#
# With NEXT_PUBLIC_SANITY_PROJECT_ID unset the site serves the content bundled
# in src/content, so local work and CI need none of this.
# ---------------------------------------------------------------------------

# sanity.io/manage -> your project -> the id under the project name.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Only for a private dataset. A public dataset needs no token and is served
# from Sanity's CDN, which is faster.
SANITY_API_READ_TOKEN=

# Write token, used only by `npm run sanity:seed`. Never ship this to the client.
SANITY_WRITE_TOKEN=

# Shared secret for the Sanity publish webhook -> /api/revalidate.
SANITY_REVALIDATE_SECRET=
